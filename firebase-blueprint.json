{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and account information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "fullName": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "contact": { "type": "string", "maxLength": 50 },
        "avatar": { "type": "string", "maxLength": 2048 },
        "idDocName": { "type": "string", "maxLength": 200 },
        "termsAccepted": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "termsAccepted"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user registration, terms acceptance, and profile completion records"
    }
  }
}
