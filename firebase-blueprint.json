{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, account, tenant affiliation, and subscription records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "fullName": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 500 },
        "location": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "contact": { "type": "string", "maxLength": 50 },
        "avatar": { "type": "string", "maxLength": 150000 },
        "idDocName": { "type": "string", "maxLength": 200 },
        "termsAccepted": { "type": "boolean" },
        "tenantId": { "type": "string", "maxLength": 128 },
        "referredBy": { "type": "string", "maxLength": 150 },
        "activationOption": { "type": "string", "enum": ["tenant", "subscription", null] },
        "activationDate": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending", "verified", "rejected", "unpaid"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "inactive", "expired"] },
        "verificationStatus": { "type": "string", "enum": ["approved", "rejected", "pending"] },
        "paymentProofUrl": { "type": "string", "maxLength": 2048 },
        "profileCompleted": { "type": "boolean" },
        "avatarUpdateCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "termsAccepted"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user registration, tenant linkage, verification status, and subscription records"
    }
  }
}
